DATABASE_URL=postgresql://user:password@localhost:5432/iptvpanel
JWT_SECRET=change_this_to_a_secure_random_value_min_32_chars
AUTH_COOKIE_NAME=token
ENABLE_PUBLIC_REGISTER=false
PUBLIC_REGISTER_KEY=replace_with_shared_signup_key
ENABLE_DEBUG_ROUTES=false
ENABLE_RECAPTCHA=false
RECAPTCHA_SECRET_KEY=replace_with_google_recaptcha_secret_key

# Example: DATABASE_URL=postgresql://postgres:password@localhost:5432/iptvpanel
