DATABASE_URL=postgresql://user:password@localhost:5432/iptvpanel
JWT_SECRET=change_this_to_a_secure_random_value_min_32_chars
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FIELD_ENCRYPTION_KEY=change_this_to_a_64char_hex_or_32plus_char_random_value
AUTH_COOKIE_NAME=token
ENABLE_PUBLIC_REGISTER=false
PUBLIC_REGISTER_KEY=replace_with_shared_signup_key
ENABLE_DEBUG_ROUTES=false
ENABLE_RECAPTCHA=false
RECAPTCHA_SECRET_KEY=replace_with_google_recaptcha_secret_key
PAYMENT_PROVIDER=manual
ALLOW_MANUAL_PAYMENT_TESTING=true
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
PUBLIC_FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
TRUST_PROXY=1

# Public activation/feed abuse guard (per-IP + per-MAC)
ACTIVATION_GUARD_WINDOW_MS=300000
ACTIVATION_GUARD_MAX_PER_IP=120
ACTIVATION_GUARD_MAX_PER_MAC_PER_IP=30
ACTIVATION_GUARD_BLOCK_MS=1800000
ACTIVATION_GUARD_ANOMALY_THRESHOLD=220
DEVICE_KEY_MISMATCH_SPIKE_THRESHOLD=25
DEVICE_KEY_MISMATCH_SPIKE_WINDOW_MS=600000

# Public pricing endpoint rate limits
PUBLIC_PRICING_READ_RATE_LIMIT_MAX=100
PUBLIC_PRICING_WRITE_RATE_LIMIT_MAX=30

# Optional webhook for security alerts
SECURITY_ALERT_WEBHOOK_URL=
SECURITY_ALERT_COOLDOWN_MS=300000

# Example: DATABASE_URL=postgresql://postgres:password@localhost:5432/iptvpanel
