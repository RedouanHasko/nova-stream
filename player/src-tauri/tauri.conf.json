{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nova Player",
  "version": "0.2.5",
  "identifier": "com.novaplayer.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:4000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nova Player",
        "label": "main",
        "width": 1280,
        "height": 720,
        "minWidth": 1024,
        "minHeight": 576,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [],
    "publisher": "Nova Player",
    "copyright": "Copyright © 2026 Nova Player",
    "shortDescription": "Nova Player IPTV",
    "longDescription": "Nova Player IPTV app for Windows 10 and Windows 11.",
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "displayLanguageSelector": true,
        "installMode": "currentUser"
      }
    }
  }
}
