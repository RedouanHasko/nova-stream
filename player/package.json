{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "verify:bundle": "node scripts/verify-bundle-parity.mjs",
    "build:parity": "npm run build && npm run verify:bundle",
    "tauri": "tauri",
    "dev:windows": "tauri dev",
    "build:windows": "tauri build",
    "package:windows": "tauri build --bundles nsis",
    "package:webos": "npm run build:parity && ares-package dist -o .",
    "deploy:webos": "npm run package:webos && ares-install -d TV17 com.novaplayer.app_0.2.5_all.ipk && ares-launch -d TV17 com.novaplayer.app",
    "package:tizen": "npm run build:parity && tizen package -t wgt -o . -- dist",
    "install:tizen": "npm run package:tizen && tizen install -n NovaPlayer.wgt",
    "preview:parity": "npm run build:parity && vite preview",
    "simulator:open": "ares-launch -s 24 -sp \"C:\\TV\\Simulator\\webOS_TV_24_Simulator_1.4.1\" \"C:\\Users\\red-h\\Downloads\\iptvpanel\\player\\dist\"",
    "simulator:run": "npm run build && npm run simulator:open",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
