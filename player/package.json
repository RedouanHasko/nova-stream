    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.14.0",
    "react-window": "^2.2.7",
    "shaka-player": "^5.1.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "video.js": "^8.23.7",
